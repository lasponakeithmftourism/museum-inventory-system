{
  "name": "museum-inventory-system",
  "productName": "Museum Inventory System",
  "version": "1.0.0",
  "private": true,
  "description": "A desktop collection register for museum artifacts, artworks, books, costumes, buildings, and heritage sites.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k --success first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && node electron/dev.cjs\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "dist:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "firebase": "^11.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.16.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "ph.gov.manolofortich.museumcollections",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/printing.cjs",
      "electron/driveAuth.cjs",
      "electron/driveAttachments.cjs",
      "shared/driveApi.mjs",
      "electron/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "@firebase/util": true,
    "electron": true,
    "esbuild": true,
    "protobufjs": true
  },
  "overrides": {
    "yauzl": "3.3.1"
  }
}
